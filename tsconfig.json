{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@nanopi/chord": [
				"./packages/chord/src/index.ts"
			],
			"@nanopi/chord/bundler": [
				"./packages/chord/src/bundler.ts"
			],
			"@nanopi/chord/context": [
				"./packages/chord/src/context/index.ts"
			],
			"@nanopi/chord/delta": [
				"./packages/chord/src/delta/index.ts"
			],
			"@nanopi/chord/node": [
				"./packages/chord/src/node.ts"
			],
			"@nanopi/pi-telemetry": [
				"./packages/telemetry/src/index.ts"
			],
			"@nanopi/pi-telemetry/testing": [
				"./packages/telemetry/src/testing/index.ts"
			],
			"@nanopi/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@nanopi/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@nanopi/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@nanopi/pi-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@nanopi/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@nanopi/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@nanopi/pi-coding-agent/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@nanopi/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@nanopi/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@nanopi/pi-tui/*": [
				"./packages/tui/src/*"
			],
			"@nanopi/pi-agent-old": [
				"./packages/agent-old/src/index.ts"
			],
			"@nanopi/pi-agent-old/*": [
				"./packages/agent-old/src/*"
			]
		}
	},
	"include": [
		"scripts/model-catalog-protocol.ts",
		"scripts/model-catalog-protocol.test.ts",
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*",
		"packages/agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**"
	]
}
