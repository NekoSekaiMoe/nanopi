{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@nanopi/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@nanopi/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@nanopi/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@nanopi/pi-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@nanopi/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@nanopi/pi-extra": [
				"./packages/extra/src/index.ts"
			],
			"@nanopi/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@nanopi/pi-coding-agent/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@nanopi/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@earendil-works/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@earendil-works/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"@earendil-works/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@earendil-works/pi-agent-core/*": [
				"./packages/agent/src/*"
			],
			"@earendil-works/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@earendil-works/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@earendil-works/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@earendil-works/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@earendil-works/pi-tui/*": [
				"./packages/tui/src/*"
			],
			"@nanopi/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@nanopi/pi-tui/*": [
				"./packages/tui/src/*"
			],
			"@nanopi/pi-agent-old": [
				"./packages/agent-old/src/index.ts"
			],
			"@nanopi/pi-agent-old/*": [
				"./packages/agent-old/src/*"
			]
		}
	},
	"include": [
		"scripts/model-catalog-protocol.ts",
		"scripts/model-catalog-protocol.test.ts",
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*",
		"packages/agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/webui",
		"packages/webui-next",
		"packages/coding-agent/src/extras/**/__tests__/**"
	]
}
