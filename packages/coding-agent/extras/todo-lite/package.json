{
	"name": "todo-lite",
	"version": "0.5.0",
	"description": "AI-driven todo list for Pi — stateful task management with session persistence and /todos command. (lean fork, zero deps)",
	"type": "module",
	"main": "src/index.ts",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"keywords": [
		"pi-package",
		"extension",
		"todo",
		"task",
		"list"
	],
	"license": "MIT",
	"files": [
		"src/",
		"index.ts"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@earendil-works/pi-ai": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		}
	}
}
