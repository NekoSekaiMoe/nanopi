		"src/modules/pi-meat/**/__tests__/**",
		"src/modules/pi-meat/**/*.test.ts",
		"src/modules/pi-meat/**/vitest.config.ts",
		"src/modules/pi-memory/**/__tests__/**",
		"src/modules/pi-memory/**/*.test.ts",
		"src/modules/pi-memory/**/vitest.config.ts",
		"src/modules/pi-output-compact/**/__tests__/**",
