{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@nanopi/pi-agent-core": ["../agent/dist/index.d.ts"],
			"@nanopi/pi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@nanopi/pi-ai": ["../ai/dist/index.d.ts"],
			"@nanopi/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/*/index.d.ts", "../ai/dist/providers/*.d.ts"],
			"@nanopi/pi-tui": ["../tui/dist/index.d.ts"],
			"@nanopi/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"],
			"@nanopi/pi-coding-agent": ["./src/index.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"src/client",
		"src/experimental",
		"src/cli/experimental",
		"src/modules/ask-lite/**/__tests__/**",
		"src/modules/ask-lite/**/*.test.ts",
		"src/modules/ask-lite/**/vitest.config.ts",
		"src/modules/mcp-lite/**/__tests__/**",
		"src/modules/mcp-lite/**/*.test.ts",
		"src/modules/mcp-lite/**/vitest.config.ts",
