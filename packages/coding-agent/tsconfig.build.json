		"src/modules/pi-btw/**/vitest.config.ts",
		"src/modules/pi-deepwiki/**/__tests__/**",
		"src/modules/pi-deepwiki/**/*.test.ts",
		"src/modules/pi-deepwiki/**/vitest.config.ts",
		"src/modules/pi-fake-codex/**/__tests__/**",
