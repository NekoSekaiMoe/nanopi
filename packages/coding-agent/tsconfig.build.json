		"src/modules/pi-simplify/**/vitest.config.ts",
		"src/modules/pi-smart-flow/**/__tests__/**",
		"src/modules/pi-smart-flow/**/*.test.ts",
		"src/modules/pi-smart-flow/**/vitest.config.ts",
		"src/modules/pi-subagent-mini/**/__tests__/**",
		"src/modules/pi-subagent-mini/**/*.test.ts",
