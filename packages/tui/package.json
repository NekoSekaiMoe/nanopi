{
	"name": "@nanopi/pi-tui",
	"version": "20261022.0.0",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native": "node native/build-native.mjs --host",
		"build:native:darwin": "node native/build-native.mjs darwin",
		"build:native:linux": "node native/build-native.mjs linux",
		"build:native:win32": "node native/build-native.mjs win32",
		"test": "node --import ../../ts-import.mjs --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "pnpm run clean && pnpm run build"
	},
	"files": [
		"dist/**/*",
		"native/build-native.mjs",
		"native/src/**/*.{h,c,m}",
		"native/*/prebuilds/**/*.node",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NekoSekaiMoe/nanopi.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.7.0",
		"marked": "18.0.11",
		"marked-cjk-friendly": "0.1.3"
	},
	"devDependencies": {
		"@xterm/headless": "6.0.0",
		"chalk": "6.0.0"
	}
}
