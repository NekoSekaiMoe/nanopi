{
	"name": "@nanopi/pi-extra",
	"version": "20261031.0.0",
	"description": "Run modes, permission gating, subsystem toggles, ENV overrides, and webui bridge module for nanopi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@nanopi/pi-tui": "^20261031.0.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"keywords": [
		"nanopi",
		"coding-agent",
		"run-modes",
		"permissions"
	],
	"author": "NekoSekaiMoe",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NekoSekaiMoe/nanopi.git",
		"directory": "packages/extra"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
